      },
      "chat": {
        "title": "Every inquiry, answered in seconds",
        "body": "Lumi replies at any hour, asks how they'll pay and their budget, and leaves the lead file ready. You can answer for Carolina."
      },
      "site": {
        "title": "Your website searches and books",
        "body": "Filters by area, rooms and price, a listing page with the floor plan and “Book a viewing”. Book one: it shows up in the calendar and the pipeline."
      },
      "pipeline": {
        "title": "A pipeline that sorts itself",
        "body": "Each lead goes from New to Qualified, Viewing and Reserved as Lumi moves forward. Drag a card or use “Move” to sort it by hand."
      },
